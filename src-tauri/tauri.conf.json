{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Vynlore",
  "version": "1.1.0",
  "identifier": "com.vynlore.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vynlore",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: tauri:; media-src 'self' asset: tauri: file:; connect-src ipc: http://ipc.localhost; font-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/**", "$APPLOCALDATA/**", "$DOWNLOAD/**", "$MUSIC/**", "$HOME/Music/**", "$HOME/**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "languages": ["English"]
      }
    },
    "fileAssociations": [
      {
        "ext": ["flac"],
        "mimeType": "audio/flac",
        "name": "FLAC Audio",
        "description": "Vynlore - Lossless Audio Player"
      },
      {
        "ext": ["wav", "wave"],
        "mimeType": "audio/wav",
        "name": "WAV Audio",
        "description": "Vynlore - Lossless Audio Player"
      },
      {
        "ext": ["aiff", "aif"],
        "mimeType": "audio/aiff",
        "name": "AIFF Audio",
        "description": "Vynlore - Lossless Audio Player"
      },
      {
        "ext": ["mp3"],
        "mimeType": "audio/mpeg",
        "name": "MP3 Audio",
        "description": "Vynlore - Lossless Audio Player"
      },
      {
        "ext": ["m4a", "m4b"],
        "mimeType": "audio/mp4",
        "name": "M4A Audio",
        "description": "Vynlore - Lossless Audio Player"
      },
      {
        "ext": ["ogg", "oga", "opus"],
        "mimeType": "audio/ogg",
        "name": "OGG Audio",
        "description": "Vynlore - Lossless Audio Player"
      },
      {
        "ext": ["wma"],
        "mimeType": "audio/x-ms-wma",
        "name": "WMA Audio",
        "description": "Vynlore - Lossless Audio Player"
      },
      {
        "ext": ["ape"],
        "mimeType": "audio/ape",
        "name": "APE Audio",
        "description": "Vynlore - Lossless Audio Player"
      },
      {
        "ext": ["wv"],
        "mimeType": "audio/wavpack",
        "name": "WavPack Audio",
        "description": "Vynlore - Lossless Audio Player"
      },
      {
        "ext": ["dsf", "dff"],
        "mimeType": "audio/dsd",
        "name": "DSD Audio",
        "description": "Vynlore - Lossless Audio Player"
      }
    ]
  }
}
